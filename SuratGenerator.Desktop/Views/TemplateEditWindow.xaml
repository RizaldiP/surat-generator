<ui:FluentWindow x:Class="SuratGenerator.Desktop.Views.TemplateEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edit Metadata Template"
                 Width="440"
                 Height="360"
                 MinWidth="400"
                 MinHeight="320"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit Metadata Template" Margin="-24,-24,-24,0"/>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <TextBlock Text="Nama template" Style="{StaticResource AppBodyText}"/>
            <ui:TextBox Margin="0,6,0,0"
                        Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,16,0,0" Text="Kategori" Style="{StaticResource AppBodyText}"/>
            <ui:TextBox Margin="0,6,0,0"
                        Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,16,0,0" Text="Versi" Style="{StaticResource AppBodyText}"/>
            <ui:TextBox Margin="0,6,0,0"
                        Text="{Binding VersionText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Content="Batal" Click="OnCancel"/>
            <ui:Button Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="Simpan"
                       Click="OnSave"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
