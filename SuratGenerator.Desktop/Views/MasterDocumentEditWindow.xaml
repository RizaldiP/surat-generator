<ui:FluentWindow x:Class="SuratGenerator.Desktop.Views.MasterDocumentEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Master Dokumen"
                 Width="460"
                 Height="300"
                 MinWidth="420"
                 MinHeight="280"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding WindowTitle}"
                     Margin="-24,-24,-24,0"/>

        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <TextBlock Text="Nama tampilan" Style="{StaticResource AppBodyText}"/>
            <ui:TextBox Margin="0,6,0,0"
                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Margin="0,14,0,0"
                      Content="File wajib ada pada setiap pekerjaan"
                      IsChecked="{Binding IsRequired}"/>
            <TextBlock Margin="0,12,0,0"
                       Text="Nama tampilan dipakai sebagai identitas master dokumen pada kategori ini."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Content="Batal" Click="OnCancel"/>
            <ui:Button Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="Simpan"
                       Click="OnSave"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
