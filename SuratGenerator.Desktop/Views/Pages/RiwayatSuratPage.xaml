<Page x:Class="SuratGenerator.Desktop.Views.Pages.RiwayatSuratPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SuratGenerator.Desktop.Views.Controls"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Riwayat Surat" Style="{StaticResource AppTitleText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Dokumen yang diekspor atau dicetak akan tercatat di sini."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,16,0,12" Padding="12">
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Right"
                           Command="{Binding RefreshCommand}"
                           Content="Muat Ulang"
                           Icon="{ui:SymbolIcon ArrowSync24}"/>
                <TextBlock VerticalAlignment="Center"
                           Text="Aktivitas dokumen"
                           Style="{StaticResource AppSectionText}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListView ItemsSource="{Binding Documents}"
                      SelectionMode="Single"
                      Visibility="{Binding HasDocuments, Converter={StaticResource AppBoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Dokumen" Width="260" DisplayMemberBinding="{Binding DocumentName}"/>
                        <GridViewColumn Header="Template" Width="200" DisplayMemberBinding="{Binding TemplateName}"/>
                        <GridViewColumn Header="Jenis" Width="90" DisplayMemberBinding="{Binding FormatLabel}"/>
                        <GridViewColumn Header="Ukuran" Width="90" DisplayMemberBinding="{Binding FileSizeText}"/>
                        <GridViewColumn Header="Waktu" Width="170" DisplayMemberBinding="{Binding GeneratedAtText}"/>
                        <GridViewColumn Header="Aksi" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Buka"
                                                   Icon="{ui:SymbolIcon Open24}"
                                                   IsEnabled="{Binding HasFile}"/>
                                        <ui:Button Margin="8,0,0,0"
                                                   Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Folder"
                                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                                   IsEnabled="{Binding HasFile}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <controls:EmptyStateControl TitleText="Belum ada riwayat"
                                        MessageText="Ekspor atau cetak surat dari halaman Buat Surat untuk melihat riwayat."
                                        Glyph="Clock24">
                <controls:EmptyStateControl.Style>
                    <Style TargetType="controls:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDocuments}" Value="False"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStateControl.Style>
            </controls:EmptyStateControl>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatus, Converter={StaticResource AppBoolToVisibility}}"
                   Style="{StaticResource AppSecondaryText}"/>
    </Grid>
</Page>
