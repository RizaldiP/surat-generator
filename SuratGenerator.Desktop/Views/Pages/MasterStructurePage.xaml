<Page x:Class="SuratGenerator.Desktop.Views.Pages.MasterStructurePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SuratGenerator.Desktop.Views.Controls"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Master Struktur Folder" Style="{StaticResource AppTitleText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Atur kategori folder untuk pekerjaan baru. Perubahan tidak mengubah pekerjaan lama."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,16,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Command="{Binding AddCommand}"
                           Content="Tambah Kategori"
                           Appearance="Primary"/>
                <ui:Button Grid.Column="2"
                           Command="{Binding RefreshCommand}"
                           Content="Refresh"/>
                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Text="{Binding StructureVersion, StringFormat=Versi struktur: {0}}"
                           Style="{StaticResource AppSecondaryText}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="CategoryListView"
                      Grid.Column="0"
                      ItemsSource="{Binding Categories}"
                      SelectionMode="Single"
                      AllowDrop="True"
                      Visibility="{Binding HasCategories, Converter={StaticResource AppBoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="No" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SortOrder, StringFormat=00}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nama Kategori" Width="260" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Versi" Width="70" DisplayMemberBinding="{Binding Version}"/>
                        <GridViewColumn Header="Status" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Nonaktif"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="Aktif"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Aksi" Width="430">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Naik"/>
                                        <ui:Button Margin="6,0,0,0"
                                                   Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Turun"/>
                                        <ui:Button Margin="6,0,0,0"
                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Edit"/>
                                        <ui:Button Margin="6,0,0,0"
                                                   Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button">
                                                    <Setter Property="Content" Value="Aktifkan"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Content" Value="Nonaktifkan"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Margin="6,0,0,0"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Hapus"
                                                   Appearance="Caution"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <controls:EmptyStateControl Grid.Column="0"
                                        TitleText="Belum ada kategori aktif"
                                        MessageText="{Binding EmptyStateMessage}"
                                        Glyph="FolderOpen24">
                <controls:EmptyStateControl.Style>
                    <Style TargetType="controls:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasCategories}" Value="False"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStateControl.Style>
            </controls:EmptyStateControl>

            <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ChecklistTitle}" Style="{StaticResource AppSectionText}"/>
                    <ui:Button Grid.Row="1"
                               Margin="0,8,0,8"
                               Command="{Binding AddChecklistItemCommand}"
                               Content="Tambah Item Wajib"
                               Appearance="Primary"/>
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding ChecklistItems}"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="No" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SortOrder, StringFormat=00}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Nama Item" Width="170" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="Status" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Nonaktif"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Aktif"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Aksi" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Command="{Binding DataContext.EditChecklistItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Edit"/>
                                                <ui:Button Margin="6,0,0,0"
                                                           Command="{Binding DataContext.ToggleChecklistItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button">
                                                            <Setter Property="Content" Value="Aktifkan"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Content" Value="Nonaktifkan"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                                <ui:Button Margin="6,0,0,0"
                                                           Command="{Binding DataContext.DeleteChecklistItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                           CommandParameter="{Binding}"
                                                           Content="Hapus"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Tarik baris untuk mengubah urutan, atau gunakan tombol Naik/Turun."
                       Style="{StaticResource AppSecondaryText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding HasStatus, Converter={StaticResource AppBoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
