<Page x:Class="SuratGenerator.Desktop.Views.Pages.DraftPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SuratGenerator.Desktop.Views.Controls"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Draft" Style="{StaticResource AppTitleText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Draft surat tersimpan otomatis dan dapat dibuka kembali untuk diedit."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,16,0,12" Padding="12">
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Right"
                           Command="{Binding RefreshCommand}"
                           Content="Muat Ulang"
                           Icon="{ui:SymbolIcon ArrowSync24}"/>
                <TextBlock VerticalAlignment="Center"
                           Text="Daftar draft terakhir"
                           Style="{StaticResource AppSectionText}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListView ItemsSource="{Binding Drafts}"
                      SelectionMode="Single"
                      Visibility="{Binding HasDrafts, Converter={StaticResource AppBoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nama Draft" Width="260" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Template" Width="220" DisplayMemberBinding="{Binding TemplateName}"/>
                        <GridViewColumn Header="Diperbarui" Width="180" DisplayMemberBinding="{Binding UpdatedAtText}"/>
                        <GridViewColumn Header="Aksi" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Appearance="Primary"
                                               Command="{Binding DataContext.OpenDraftCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                               CommandParameter="{Binding}"
                                               Content="Buka"
                                               Icon="{ui:SymbolIcon DocumentEdit24}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <controls:EmptyStateControl TitleText="Belum ada draft"
                                        MessageText="Isi field pada halaman Buat Surat untuk membuat draft otomatis."
                                        Glyph="FolderOpen24">
                <controls:EmptyStateControl.Style>
                    <Style TargetType="controls:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDrafts}" Value="False"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStateControl.Style>
            </controls:EmptyStateControl>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatus, Converter={StaticResource AppBoolToVisibility}}"
                   Style="{StaticResource AppSecondaryText}"/>
    </Grid>
</Page>
