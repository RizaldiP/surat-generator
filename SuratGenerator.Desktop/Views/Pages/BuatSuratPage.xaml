<Page x:Class="SuratGenerator.Desktop.Views.Pages.BuatSuratPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SuratGenerator.Desktop.Views.Controls"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Buat Surat" Style="{StaticResource AppTitleText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Pilih template dari folder, lalu isi field yang terdeteksi otomatis."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,16,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Cari template..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTipService.ToolTip="{Binding SearchTooltip}"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTipService.ToolTip="{Binding FilterTooltip}"/>
                <StackPanel Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox Margin="0,0,12,0"
                              Content="Favorit saja"
                              IsChecked="{Binding ShowFavoritesOnly}"
                              ToolTipService.ToolTip="Tampilkan hanya template yang ditandai favorit"/>
                    <TextBlock Text="Template dari folder"
                               Style="{StaticResource AppSecondaryText}"/>
                </StackPanel>
                <ui:Button Grid.Column="5"
                           Appearance="Primary"
                           Command="{Binding ScanFolderCommand}"
                           Content="Pindai Folder"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTipService.ToolTip="{Binding UpdateTooltip}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Data Surat" Style="{StaticResource AppSectionText}"/>
                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasTemplate, Converter={StaticResource AppBoolToVisibility}}">
                        <TextBlock Text="{Binding TemplateName}" Style="{StaticResource AppBodyText}" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,2,0,0" Text="{Binding FieldSummary}" Style="{StaticResource AppSecondaryText}"/>
                        <TextBlock Margin="0,2,0,0" Text="{Binding DraftStatusText}" Style="{StaticResource AppSecondaryText}"/>
                    </StackPanel>
                    <ProgressBar Grid.Row="2"
                                 Height="4"
                                 Margin="0,8,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource AppBoolToVisibility}}"/>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasFields, Converter={StaticResource AppBoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Margin="0,0,0,4" Text="{Binding Label}" Style="{StaticResource AppBodyText}"/>
                                            <ui:TextBox PlaceholderText="Isi nilai"
                                                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <controls:EmptyStateControl TitleText="Belum ada template"
                                                     MessageText="Pilih folder template di Pengaturan lalu tekan Pindai Folder."
                                                    Glyph="DocumentEdit24">
                            <controls:EmptyStateControl.Style>
                                <Style TargetType="controls:EmptyStateControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasFields}" Value="False"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:EmptyStateControl.Style>
                        </controls:EmptyStateControl>
                    </Grid>
                     <TextBlock Grid.Row="4"
                                Margin="0,8,0,0"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasStatus, Converter={StaticResource AppBoolToVisibility}}">
                         <TextBlock.Style>
                             <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryText}">
                                 <Style.Triggers>
                                     <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                         <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                         <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                                     </DataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </TextBlock.Style>
                     </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource AppCard}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Pratinjau" Style="{StaticResource AppSectionText}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Width="36"
                                       Command="{Binding ZoomOutCommand}"
                                       Content="−"
                                       ToolTipService.ToolTip="Perkecil"/>
                            <TextBlock Margin="8,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding ZoomText}"
                                       Style="{StaticResource AppSecondaryText}"/>
                            <ui:Button Width="36"
                                       Command="{Binding ZoomInCommand}"
                                       Content="+"
                                       ToolTipService.ToolTip="Perbesar"/>
                            <ui:Button Margin="8,0,0,0"
                                       Command="{Binding FitWidthCommand}"
                                       CommandParameter="{Binding ActualWidth, ElementName=PreviewHost}"
                                       Content="Fit"
                                       ToolTipService.ToolTip="Sesuaikan dengan lebar"/>
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="PreviewHost"
                            Grid.Row="1"
                            Background="{DynamicResource AppSurfaceAltBrush}"
                            CornerRadius="8">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid Margin="12">
                                    <ItemsControl ItemsSource="{Binding PreviewPages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,12"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource AppSurfaceBrush}"
                                                        CornerRadius="4">
                                                    <Image Width="{Binding PageWidth}"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Image}"
                                                           Stretch="Uniform">
                                                        <Image.LayoutTransform>
                                                            <ScaleTransform ScaleX="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                            ScaleY="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"/>
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <controls:EmptyStateControl TitleText="Pratinjau belum tersedia"
                                                                MessageText="Pilih template, lalu isi field untuk melihat pratinjau."
                                                                Glyph="DocumentText24">
                                        <controls:EmptyStateControl.Style>
                                            <Style TargetType="controls:EmptyStateControl">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasPreview}" Value="False"/>
                                                            <Condition Binding="{Binding IsPreviewLoading}" Value="False"/>
                                                            <Condition Binding="{Binding HasPreviewError}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:EmptyStateControl.Style>
                                    </controls:EmptyStateControl>
                                </Grid>
                            </ScrollViewer>
                            <Border Margin="12"
                                    Padding="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    CornerRadius="8"
                                    Visibility="{Binding IsPreviewLoading, Converter={StaticResource AppBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Width="120"
                                                 Height="4"
                                                 IsIndeterminate="True"/>
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Membuat pratinjau..."
                                               Style="{StaticResource AppSecondaryText}"/>
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="20"
                                    Panel.ZIndex="2"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    CornerRadius="8"
                                    Visibility="{Binding HasPreviewError, Converter={StaticResource AppBoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock MaxWidth="320"
                                               Text="{Binding PreviewError}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource AppBodyText}"/>
                                    <ui:Button Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Appearance="Primary"
                                               Command="{Binding RetryPreviewCommand}"
                                               Content="Coba Lagi"
                                               Icon="{ui:SymbolIcon ArrowSync24}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource AppCard}" Margin="0,12,0,0" Padding="12">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Content="Simpan Draft"
                           Command="{Binding SaveDraftCommand}"
                           Icon="{ui:SymbolIcon SaveEdit24}"/>
                <ui:Button Margin="8,0,0,0"
                           Content="Reset"
                           Command="{Binding ResetFormCommand}"
                           Icon="{ui:SymbolIcon ArrowReset24}"/>
                <ui:Button Margin="8,0,0,0"
                           Content="Ekspor Word"
                           Command="{Binding ExportWordCommand}"
                           Icon="{ui:SymbolIcon DocumentArrowDown24}"/>
                <ui:Button Margin="8,0,0,0"
                           Content="Ekspor PDF"
                           Command="{Binding ExportPdfCommand}"
                           Icon="{ui:SymbolIcon DocumentPdf24}"/>
                <ui:Button Margin="8,0,0,0"
                           Content="Cetak"
                           Command="{Binding PrintCommand}"
                           Icon="{ui:SymbolIcon DocumentPrint24}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
