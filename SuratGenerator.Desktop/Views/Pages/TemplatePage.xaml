<Page x:Class="SuratGenerator.Desktop.Views.Pages.TemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SuratGenerator.Desktop.Views.Controls"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Template" Style="{StaticResource AppTitleText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Cari, urutkan, dan kelola seluruh template surat lokal."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,16,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Cari nama, file, atau kategori"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          ToolTipService.ToolTip="Filter kategori"/>
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"
                          ToolTipService.ToolTip="Urutkan template"/>
                <CheckBox Grid.Column="6"
                          VerticalAlignment="Center"
                          Content="Favorit saja"
                          IsChecked="{Binding ShowFavoritesOnly}"
                          ToolTipService.ToolTip="Tampilkan hanya template yang ditandai favorit"/>
                 <ui:Button Grid.Column="8"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Icon="{ui:SymbolIcon ArrowSync24}"/>
                 <ui:Button Grid.Column="10"
                            Command="{Binding ScanFolderCommand}"
                            Content="Pindai Folder"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Appearance="Primary"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListView ItemsSource="{Binding VisibleTemplates}"
                      SelectionMode="Single"
                      Visibility="{Binding HasTemplates, Converter={StaticResource AppBoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nama Template" Width="240" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Kategori" Width="120" DisplayMemberBinding="{Binding Category}"/>
                        <GridViewColumn Header="Versi" Width="80" DisplayMemberBinding="{Binding Version}"/>
                        <GridViewColumn Header="Field" Width="80" DisplayMemberBinding="{Binding FieldCountText}"/>
                        <GridViewColumn Header="Status File" Width="110" DisplayMemberBinding="{Binding FileStatusText}"/>
                        <GridViewColumn Header="Sumber" Width="130" DisplayMemberBinding="{Binding SourceStatusText}"/>
                        <GridViewColumn Header="Favorit" Width="80" DisplayMemberBinding="{Binding FavoriteText}"/>
                        <GridViewColumn Header="Diimpor" Width="160" DisplayMemberBinding="{Binding ImportedAtText}"/>
                        <GridViewColumn Header="Aksi" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Primary">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button">
                                                    <Setter Property="Content" Value="Jadikan Favorit"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Content" Value="Hapus Favorit"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Margin="8,0,0,0"
                                                   Command="{Binding DataContext.EditMetadataCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Edit"
                                                   Icon="{ui:SymbolIcon Edit24}"/>
                                        <ui:Button Margin="8,0,0,0"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}"
                                                   Content="Hapus Lokal"
                                                   Icon="{ui:SymbolIcon Delete24}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <controls:EmptyStateControl TitleText="Belum ada template"
                                        MessageText="{Binding EmptyStateMessage}"
                                        Glyph="DocumentMultiple24">
                <controls:EmptyStateControl.Style>
                    <Style TargetType="controls:EmptyStateControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasTemplates}" Value="False"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:EmptyStateControl.Style>
            </controls:EmptyStateControl>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatus, Converter={StaticResource AppBoolToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Page>
