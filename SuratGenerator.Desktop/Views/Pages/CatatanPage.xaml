<Page x:Class="SuratGenerator.Desktop.Views.Pages.CatatanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:SuratGenerator.Desktop.Views.Controls"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Catatan" Style="{StaticResource AppTitleText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="Catat syarat pembuatan surat, misalnya Pembuatan SIK: Surat Permohonan, SC, SPMK, dan lain-lain."
                       Style="{StaticResource AppSecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource AppCard}" Margin="0,16,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0"
                           Command="{Binding AddNoteCommand}"
                           Content="Tambah Catatan"
                           Appearance="Primary"/>
                <ui:Button Grid.Column="2"
                           Command="{Binding RefreshCommand}"
                           Content="Refresh"/>
                <ui:TextBox Grid.Column="4"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Cari catatan, syarat, atau keterangan"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <ui:Button Grid.Column="6"
                           Command="{Binding ClearSearchCommand}"
                           Content="Hapus Pencarian"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListView ItemsSource="{Binding Notes}"
                          SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                          SelectionMode="Single"
                          Visibility="{Binding HasNotes, Converter={StaticResource AppBoolToVisibility}}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="No" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SortOrder, StringFormat=00}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Judul Catatan" Width="220" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Diperbarui" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd-MM-yyyy HH:mm}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Aksi" Width="360">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Command="{Binding DataContext.MoveNoteUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Naik"/>
                                            <ui:Button Margin="6,0,0,0"
                                                       Command="{Binding DataContext.MoveNoteDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Turun"/>
                                            <ui:Button Margin="6,0,0,0"
                                                       Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Edit"/>
                                            <ui:Button Margin="6,0,0,0"
                                                       Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Hapus"
                                                       Appearance="Caution"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <controls:EmptyStateControl TitleText="Belum ada catatan"
                                            MessageText="{Binding EmptyStateMessage}"
                                            Glyph="Notebook24">
                    <controls:EmptyStateControl.Style>
                        <Style TargetType="controls:EmptyStateControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasNotes}" Value="False"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:EmptyStateControl.Style>
                </controls:EmptyStateControl>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ItemTitle}" Style="{StaticResource AppSectionText}"/>
                    <ui:Button Grid.Row="1"
                               Margin="0,8,0,8"
                               Command="{Binding AddItemCommand}"
                               Content="Tambah Syarat"
                               Appearance="Primary"/>
                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding Items}"
                                  SelectionMode="Single"
                                  Visibility="{Binding HasItems, Converter={StaticResource AppBoolToVisibility}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="No" Width="45">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SortOrder, StringFormat=00}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nama Syarat" Width="150" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Keterangan" Width="220" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Aksi" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Command="{Binding DataContext.MoveItemUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                               CommandParameter="{Binding}"
                                                               Content="Naik"/>
                                                    <ui:Button Margin="6,0,0,0"
                                                               Command="{Binding DataContext.MoveItemDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                               CommandParameter="{Binding}"
                                                               Content="Turun"/>
                                                    <ui:Button Margin="6,0,0,0"
                                                               Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                               CommandParameter="{Binding}"
                                                               Content="Edit"/>
                                                    <ui:Button Margin="6,0,0,0"
                                                               Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                               CommandParameter="{Binding}"
                                                               Content="Hapus"
                                                               Appearance="Caution"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="Belum ada syarat pada catatan ini."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Ctrl+Enter menyimpan pada dialog. Gunakan Naik/Turun untuk mengurutkan. Pencarian memfilter catatan dan syarat sementara."
                       Style="{StaticResource AppSecondaryText}"/>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding HasStatus, Converter={StaticResource AppBoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource AppSecondaryText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
