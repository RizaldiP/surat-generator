<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#162032"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#334155"/>
